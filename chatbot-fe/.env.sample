# Frontend (Vite) environment variables
# Cara pakai:
#   cp .env.sample .env
# lalu sesuaikan nilainya bila perlu.

# Base URL untuk FAQ Backend (Node/Express)
# Contoh: http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Path/URL gambar ilustrasi panel kiri
# Bisa path public (mis. /aset.jpg) atau URL penuh
VITE_ILLUSTRATION_IMG=/aset.jpg

# Opsional: versi/cache-busting untuk gambar ilustrasi.
# - "dev" cocok untuk development
# - kosongkan untuk production bila tidak diperlukan
VITE_ILLUSTRATION_VERSION=dev
