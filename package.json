{
  "name": "navacare",
  "version": "1.0.0",
  "main": "faq_backend.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node faq_backend.js",
    "start:qwen": "USE_LLM=1 OLLAMA_MODEL=qwen3:1.7b node faq_backend.js",
    "health": "curl -s http://localhost:3000/health/ollama",
    "embed:service:st": "python3 embedding_service.py",
    "embed:service:ollama": "USE_OLLAMA_EMBED=1 OLLAMA_EMBED_MODEL=nomic-embed-text python3 embedding_service.py",
    "embed:index:st": "python3 embed_and_index_qdrant.py",
    "embed:index:ollama": "USE_OLLAMA_EMBED=1 OLLAMA_EMBED_MODEL=nomic-embed-text python3 embed_and_index_qdrant.py",
    "faq:augment": "python3 augment_faq_variations.py --input data/faq.json --output data/faq_with_variations.json",
    "dev:frontend": "npm --prefix chatbot-fe run dev",
    "dev:backend": "npm run start:qwen",
    "dev:services": "node -e \"require('net').createConnection({port:5001}).on('connect',()=>process.exit(0)).on('error',()=>process.exit(1))\" || npm run embed:service:ollama",
    "dev:index": "wait-on tcp:5001 && npm run embed:index:ollama",
    "dev:serve": "concurrently -n BACKEND,FRONTEND -c magenta,cyan \"npm run start:qwen\" \"npm --prefix chatbot-fe run dev\"",
    "dev:all": "concurrently --continue-on-error -n EMBED,INIT,SERVE -c green,yellow,blue \"npm run dev:services\" \"npm run dev:index\" \"npm run dev:serve\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.13.4",
    "body-parser": "^2.2.2",
    "express": "^5.2.1",
    "string-similarity": "^4.0.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^7.2.0"
  }
}
